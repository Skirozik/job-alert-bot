# Copy this file to .env.beyonce and fill in your values.
# NEVER commit .env.beyonce — it's in .gitignore.
#
# This is a SEPARATE Supabase project, ntfy topic, and Modal secret from the
# original .env / job-alert-secrets — see scraper_beyonce/schema.sql and
# the plan doc for why the two pipelines are fully isolated.

# Supabase — create a NEW project at https://supabase.com, then run
# scraper_beyonce/schema.sql in its SQL editor (Settings -> API for these values)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Anthropic (https://console.anthropic.com -> API Keys) — safe to reuse the
# same key as the original persona; it's just an inference credential, not
# scoped to a job search.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ntfy.sh — pick a NEW hard-to-guess topic name, different from the
# original's (this is your "password"). Install the ntfy app and subscribe.
NTFY_TOPIC=beyonce-jobs-changeme-abc123
