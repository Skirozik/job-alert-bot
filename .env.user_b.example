# Copy this file to .env.user_b (repo root) and fill in your values.
# NEVER commit .env.user_b — .gitignore lists it.
#
# A SEPARATE Supabase project, ntfy topic and secret set from every other persona (see
# scraper_user_b/schema.sql and scraper_user_b/DEPLOY.md). The variable NAMES are shared across
# pipelines on purpose; isolation comes from which file (locally) or which GitHub secret
# (deployed) supplies them. Loading the wrong one writes into someone else's database.

# Supabase — the NEW project's base URL (strip any /rest/v1/ suffix) and its SECRET key
# (sb_secret_...), not the publishable one.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your-secret-key-here

# Anthropic — the shared inference key.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ntfy — User B's topic: job pings only. The topic name IS the password; it lives only here and
# in the NTFY_TOPIC_USER_B repository secret.
NTFY_TOPIC=user_b-topic-changeme

# ntfy — the OWNER's topic: every infrastructure alert (classifier down, zero results, quota,
# crashes). Never User B's topic. In Actions this comes from the repository secret NTFY_TOPIC.
OWNER_NTFY_TOPIC=owner-topic-changeme

# Optional: read the rubric from a file outside this public repo for local runs.
# CANDIDATE_PROFILE_PATH=/absolute/path/outside/the/repo/User_B_Candidate_Profile_and_Filters.md
