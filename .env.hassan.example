# Copy this file to .env.hassan and fill in your values.
# NEVER commit .env.hassan — it's in .gitignore.
#
# This is a SEPARATE Supabase project, ntfy topic, and secret set from the
# other two personas — see scraper_hassan/schema.sql. The env var NAMES are
# reused across all three pipelines on purpose; isolation comes from which
# .env file (locally) or which GitHub Actions secret (deployed) is loaded,
# NOT from renaming. Loading the wrong one writes into the wrong person's
# database, so keep them straight.

# Supabase — create a NEW project at https://supabase.com, then run
# scraper_hassan/schema.sql in its SQL editor (Settings -> Data API for the
# URL, Settings -> API Keys for the secret key).
#
# Use the SECRET key (sb_secret_...), not the publishable/anon one — the
# publishable key can't bypass RLS and every write will silently fail.
#
# SUPABASE_URL must be the BASE project URL with no path. The Data API page
# shows it with "/rest/v1/" appended; strip that, or every request goes to
# /rest/v1/rest/v1/... and 404s.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your-secret-key-here

# Anthropic (https://console.anthropic.com -> API Keys) — safe to reuse the
# same key as the other personas; it's an inference credential, not scoped
# to a particular job search.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ntfy.sh — pick a NEW hard-to-guess topic, different from the other two.
# The topic name IS the password; ntfy has no auth and auto-creates topics
# on first publish, so a typo'd topic still returns HTTP 200 and looks
# exactly like success in the logs. Subscribe on the phone BEFORE deploying
# and confirm a test push actually arrives.
NTFY_TOPIC=hassan-jobs-changeme-abc123
