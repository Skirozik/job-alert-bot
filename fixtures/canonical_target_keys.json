{
  "_comment": [
    "Shared contract between scraper/target_key.py (Python) and",
    "web/lib/dupes.ts canonicalTargetKey (TypeScript). Both are asserted",
    "against this file, so neither language can change the cross-source",
    "identity without turning a test red in the other.",
    "",
    "`expected` is the DEFINITIVE key, or null where dupes.ts falls back to",
    "its non-definitive `url:` / `row:` forms. On a null, Python must return",
    "None and TypeScript must return a string starting with url: or row:.",
    "",
    "URLs are real, taken from web/lib/__tests__/dupes.test.mjs and from",
    "scraper/ats_config.py's platforms."
  ],

  "cases": [
    {
      "name": "workday: locale + tenant-path variants of one Chevron req",
      "url": "https://chevron.wd5.myworkdayjobs.com/en-US/jobs/job/Houston/XMLNAME-2026-2027-Software-Engineer-Intern_R000072398",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": "workday:chevron:r000072398"
    },
    {
      "name": "workday: the same req with Workday's generated -1 repost suffix",
      "url": "https://chevron.wd5.myworkdayjobs.com/en-US/university/job/Houston/XMLNAME-2026-2027-Software-Engineer-Intern_R000072398-1",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": "workday:chevron:r000072398"
    },
    {
      "name": "workday: tracking params and case do not change identity",
      "url": "https://clr.wd5.myworkdayjobs.com/CLR_Careers/job/Oklahoma-City-OK/Data-Analyst-Intern--Summer-2027-_R02591-1?utm_source=Simplify&ref=Simplify",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": "workday:clr:r02591"
    },
    {
      "name": "workday: R- prefix with a hyphen compacts",
      "url": "https://lplfinancial.wd1.myworkdayjobs.com/university/job/Fort-Mill/Summer-Intern-2027---Data_R-052914",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": "workday:lplfinancial:r052914"
    },
    {
      "name": "workday: Regions ETP req",
      "url": "https://regions.wd5.myworkdayjobs.com/regions_careers/job/Hoover-AL---Riverchase-Operations-Center-Birmingham-AL/ETP_R105426",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": "workday:regions:r105426"
    },
    {
      "name": "THE CROSS-SOURCE CASE: a LinkedIn row whose apply_url is the ATS req resolves to the ATS key, not a linkedin: key",
      "url": "https://www.linkedin.com/jobs/view/digital-technology-intern-at-ge-aerospace-4455245573",
      "apply_url": "https://geaerospace.wd5.myworkdayjobs.com/ge_externalsite/job/Livonia/Digital-Technology-Intern---US---Livonia--MI---Summer-2027_R5038079-1",
      "is_easy_apply": false,
      "expected": "workday:geaerospace:r5038079"
    },
    {
      "name": "linkedin: Easy Apply keeps the LinkedIn id even when apply_url is set",
      "url": "https://www.linkedin.com/jobs/view/regions-etp-intern-4456469040",
      "apply_url": "https://regions.wd5.myworkdayjobs.com/regions_careers/job/Hoover-AL/ETP_R105426",
      "is_easy_apply": true,
      "expected": "linkedin:4456469040"
    },
    {
      "name": "linkedin: slug prefix is ignored, numeric id is the identity",
      "url": "https://www.linkedin.com/jobs/view/platform-engineering-intern-at-sanmina-4454536970",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": "linkedin:4454536970"
    },
    {
      "name": "greenhouse: board token and numeric job id from the path",
      "url": "https://job-boards.greenhouse.io/generalmatter/jobs/5377118008",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": "greenhouse:generalmatter:5377118008"
    },
    {
      "name": "lever: uuid job id, lowercased",
      "url": "https://jobs.lever.co/palantir/11111111-1111-1111-1111-111111111111",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": "lever:11111111-1111-1111-1111-111111111111"
    },
    {
      "name": "ashby: board slug plus uuid",
      "url": "https://jobs.ashbyhq.com/openai/22222222-2222-2222-2222-222222222222",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": "ashby:openai:22222222-2222-2222-2222-222222222222"
    },
    {
      "name": "smartrecruiters: long numeric posting id",
      "url": "https://jobs.smartrecruiters.com/SomeCompany/1234567890123",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": "smartrecruiters:1234567890123"
    },
    {
      "name": "icims: subdomain plus numeric id",
      "url": "https://careers-example.icims.com/jobs/98765/software-engineer-intern/job",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": "icims:careers-example:98765"
    },
    {
      "name": "jobvite: slug id",
      "url": "https://jobs.jobvite.com/example/job/oABC1defg",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": "jobvite:oabc1defg"
    },
    {
      "name": "NOT DEFINITIVE: an unrecognised careers host falls back to url:",
      "url": "https://careers.wecenergygroup.com/We_Energies/job/Milwaukee-Intern-Renewables-Data-Analytics-WI-53203/1419740100/?utm_source=Simplify",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": null
    },
    {
      "name": "NOT DEFINITIVE: a generic host with a jobs path is not an ATS requisition",
      "url": "https://example.com/jobs/42?team=data&utm_campaign=y",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": null
    },
    {
      "name": "NOT DEFINITIVE: empty href",
      "url": "",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": null
    },
    {
      "name": "NOT DEFINITIVE: malformed URL is not evidence two rows match",
      "url": "not a url at all",
      "apply_url": null,
      "is_easy_apply": false,
      "expected": null
    }
  ]
}
